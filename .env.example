# Crier environment variables — full documented env surface
# (README.md '## Configuration' table + specs/WEBHOOK-DELIVERY.md §9 +
# config/config.go + cmd/crier-mcp/main.go). Copy to .env and edit.
# CR-GAP-046: expanded from 5 to the full 30+ var surface so a copy-based
# bootstrap can never silently run the LLM guard without a provider key.
#
# Values below are the documented defaults — never real keys or secrets.

# ── Server ──────────────────────────────────────────────────────────────
# Server listen port (default 8767)
CRIER_PORT=8767

# ── Database ────────────────────────────────────────────────────────────
# PostgreSQL connection URL — the backend the documented path uses (README
# § Run, docs/integration-guide.md §1) and the one this example sets below.
# When unset, the registry and inboxes use the in-memory backend instead, which
# is demo-only: state is process-lifetime only, so agents and undelivered
# messages are lost on restart.
# Precedence: CR_DATABASE_URL → DATABASE_URL → CRIER_DATABASE_URL
# Compose publishes the container's in-container port 5432 on host port 5437
# (docker-compose.yml: "${CRIER_PG_HOST_PORT:-5437}:5432"). Start it with:
#   docker compose up -d postgres
# If host 5437 is taken, override it and use the same port in the URL below:
#   CRIER_PG_HOST_PORT=5493 docker compose up -d postgres
# If a stale container squats the project name, rescope with:
#   COMPOSE_PROJECT_NAME=crier-lab docker compose up -d postgres
CR_DATABASE_URL=postgres://crier:crier@localhost:5437/crier?sslmode=disable
# Precedence fallbacks (unset by default — kept commented):
# DATABASE_URL=
# CRIER_DATABASE_URL=
# Pool tuning (defaults from README config table):
CR_DATABASE_MAX_CONNS=4
CR_DATABASE_MIN_CONNS=0
CR_DATABASE_MAX_CONN_LIFETIME=30m
CR_DATABASE_MAX_CONN_IDLE_TIME=5m
CR_DATABASE_CONNECT_TIMEOUT=10s

# ── Auth / signing ──────────────────────────────────────────────────────
# Bearer token required on all requests except /health (CR_AUTH_TOKEN).
# Unset = auth disabled (local dev).
CR_AUTH_TOKEN=change-me-in-production

# Enforce per-agent ed25519 request signing on inbox endpoints
# (retrieve/ack/delete). Set false only for trusted single-user dev setups.
CR_REQUIRE_AGENT_SIG=true

# ── Logging ─────────────────────────────────────────────────────────────
CR_LOG_LEVEL=info
CR_LOG_FORMAT=text

# ── Rate limit / WebSocket ──────────────────────────────────────────────
# Per-agent publish rate limit (events/minute). 0 disables rate limiting.
CR_RATE_LIMIT_PER_MINUTE=100
# Global inbox-ingest budget in deliveries/minute across EVERY agent (CR-FEAT-035).
# 0 or unset = no global budget: nothing is ever shed by it, and the per-agent cap
# above stays the only backpressure. When set, a delivery over budget is refused
# 429 RATE_LIMITED_GLOBAL with a Retry-After header (whole seconds) and the same
# wait in the body, before any transport, guard call or store write.
# CR_RATE_LIMIT_GLOBAL_PER_MINUTE=0
# Comma-separated allowed WebSocket Origin headers (scheme://host:port);
# * allows all. Unset = all origins allowed.
# CR_WS_ALLOWED_ORIGINS=

# ── Federation ──────────────────────────────────────────────────────────
# Comma-separated base URLs of linked relays (relay-to-relay federation,
# CR-FEAT-006). Unset = federation disabled. Example: http://localhost:18772
# CR_FED_LINKS=
# Optional display name in GET /fed/peers. Unset = localhost:<port>.
# CR_FED_NAME=
# Shared secret for link auth (DF-CRIER-6). When set, requests forwarded to
# linked relays carry "Authorization: Bearer <token>". The linked relay must
# share the value: source CR_FED_TOKEN == destination CR_AUTH_TOKEN.
# Unset = no link auth (links are unauthenticated). Never log this value.
# CR_FED_TOKEN=
# Federation hold time (specs/WEBHOOK-DELIVERY.md §8.1/§9, default 300s, DF-CRIER-7).
# When every link fails transiently the delivery is held at this relay and
# retried for up to this long; the sender gets 202 while it is held and a
# FEDERATION_FAILED notification in its inbox if it cannot be delivered.
# A definitive all-links-404 still answers 404 immediately.
CR_FED_MAX_HOLD_S=300
# Durable hold-queue document (DF-CRIER-7). When set, held deliveries survive
# a source-relay restart (atomically rewritten JSON, recovered from <path>.bak
# after a crash). Unset = the queue lives in process memory only and held
# deliveries are lost on restart — the same demo-only contract as the in-memory
# inbox backend, so pair this with CR_DATABASE_URL in production.
# CR_FED_QUEUE_FILE=/var/lib/crier/fed-hold.json

# ── Webhook delivery (CR-FEAT-001/005) ──────────────────────────────────
# HMAC signing of outbound webhooks. Unset = no HMAC signing. When set,
# must be a real secret in .env — never a placeholder in production.
# CR_WEBHOOK_SECRET=
CR_WEBHOOK_TIMEOUT_S=30
CR_WEBHOOK_MAX_RETRIES=5
CR_WEBHOOK_REDELIVER_S=30
CR_WEBHOOK_PROBE_S=60
CR_WEBHOOK_CIRCUIT_THRESHOLD=10
# Batch flush tuning (code defaults from config/config.go Webhook struct /
# internal/webhook/driver.go; not in the spec §9 table):
CR_WEBHOOK_BATCH_MAX=10
CR_WEBHOOK_BATCH_FLUSH_S=5

# ── LLM guard (CR-FEAT-010) ─────────────────────────────────────────────
# Master switch. When on, every inbound delivery is classified before
# webhook POST / inbox store. Default true.
CR_GUARD_ENABLED=true
CR_GUARD_TIMEOUT_MS=10000
CR_GUARD_MAX_CONCURRENT=8
CR_GUARD_CIRCUIT_THRESHOLD=10
CR_GUARD_CIRCUIT_COOLDOWN_S=300
CR_GUARD_MAX_PAYLOAD_BYTES=65536
CR_GUARD_RENDER_MAX_BYTES=32768
CR_GUARD_KANBAN_QUEUE=100
CR_GUARD_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
CR_GUARD_MODEL=deepseek-v4-flash
# HTTP kanban sink base URL (http/https, CR-FEAT-009). Unset = cards go
# through the 'hermes kanban create' CLI writer.
# CR_GUARD_KANBAN_URL=
# JSON array of extra prematch patterns ([{"name","pattern","class"}]).
# Kept commented — JSON blobs would break naive KEY=VALUE sourcing.
# CR_GUARD_PATTERNS_EXTRA=
# JSON Policy used as the server-wide default. Kept commented — JSON
# blobs would break naive KEY=VALUE sourcing.
# CR_GUARD_DEFAULT_POLICY=

# ── Namespaces / realms (CR-FEAT-029) ───────────────────────────────────
# A realm dimension on agents and messages, with per-realm policy. Unset =
# one implicit namespace, and every wire surface is byte-identical to a
# server built without the feature. Set at most ONE of these two.
# Per-realm axes (each INHERITED when unset): auth ("shared" | "token" +
# token_ref "env:VAR"), rate_limit_per_minute, guard_enabled,
# guard_policy, retention_seconds. A name the server does not declare is
# refused on every lane — never a silent fallback to the default realm.
# UNKNOWN fields, duplicate names, a "token" posture whose env:VAR does not
# resolve, and retention_seconds < 1 all fail the boot.
# Kept commented — JSON blobs would break naive KEY=VALUE sourcing.
# CR_NAMESPACES={"namespaces":[{"name":"acme","rate_limit_per_minute":240,"retention_seconds":86400}]}
# CR_NAMESPACES_FILE=/etc/crier/namespaces.json

# ── Provider keys ───────────────────────────────────────────────────────
# WARNING (CR-GAP-039): the LLM guard is ON by default
# (CR_GUARD_ENABLED=true). Without a provider key, guard LLM calls fail
# and the guard FAILS OPEN — never ship a copy-based bootstrap without a
# key. Set your DeepSeek API key here:
DEEPSEEK_API_KEY=
# Alternate provider presets (env: refs in internal/guard/router.go,
# unset by default):
# GROQ_API_KEY=
# NVIDIA_API_KEY=

# ── MCP bridge (cmd/crier-mcp) ──────────────────────────────────────────
# Bridge bearer token (registry.NewRemoteStore). Unset = no auth.
# CRIER_AUTH_TOKEN=
# CRIER_AGENT_ID is required when CRIER_HTTP_URL is set.
# CRIER_AGENT_ID=
# CRIER_HTTP_URL=
# CRIER_MESH_URL=
# Optional PKCS#8 PEM ed25519 private key (openssl genpkey -algorithm ED25519)
# that signs every remote-mode request (X-Agent-Ts/X-Agent-Sig) for a server
# with CR_REQUIRE_AGENT_SIG=true (the secure default). Unset = an ephemeral
# ed25519 key is generated per run, which works against a signed server only
# while its registry is fresh: a persistent server keeps the FIRST run's
# registered public key, so later runs log a key-mismatch error and every
# signed request 401. Set this for any long-lived bridge (README.md §MCP).
# CRIER_AGENT_PRIVATE_KEY_FILE=~/.config/crier/mcp-agent.key
