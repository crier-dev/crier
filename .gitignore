# Binaries
bin/
*.exe
*.dll
*.so
*.dylib

# Test binary
*.test

# Output of go coverage
*.out

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
!.env.example

# Generated
node_modules/
dist/

# Hilo — local cache files (rebuildable)
.vfs/graph/graph.db
.vfs/graph/graph.db.wal
.vfs/graph/graph.duckdb
.vfs/graph/.last_warm

# Hilo — generated code-graph index, untracked (DF-CRIER-211). The graph is rebuilt
# locally by the hilo CLI and is never shipped; .vfs/manifest.yaml stays tracked
# (it is the hilo project manifest — config, not generated output).
.vfs/.dirty
.vfs/graph/edges.jsonl
.vfs/graph/.last_reconcile
.vfs/graph/.parse_cache.json

# GitReins history
.gitreins/history/
.gitreins/usage.jsonl

# GitReins runtime logs
.gitreins/logs/

# Stale build artifacts (from go build without -o)
/server

# Server pidfile (make run / make stop, DF-CRIER-194)
.crier.pid

# OpenCode
.opencode/
.axiom/

# Board — DuckDB local cache (rebuildable)
.coding-hermes/board/board.db
.coding-hermes/board/board.db.wal

.coding-hermes/board/*.parquet
.coding-hermes/board/*.duckdb

# Dagger cache (gitreins guard)
dagger.db*

# Python bytecode caches (examples)
__pycache__/
*.pyc
