# Remote crier-mcp mode. The tiers are cumulative: the bridge always advertises
# 23 tools, while the configured subset is 11 by default, 15 with an identity,
# 22 with the server URL, and 23 with the mesh URL.
# Tier 0: no bridge variables -> available_tools=11
# Tier 1: + CRIER_AGENT_ID -> available_tools=15
# Tier 2: + CRIER_HTTP_URL -> available_tools=22
# Tier 3: + CRIER_MESH_URL -> available_tools=23
CRIER_HTTP_URL=http://localhost:8767
CRIER_AGENT_ID=mcp-agent
CRIER_MESH_URL=ws://localhost:8767/mesh/connect/mcp-agent

# Optional stable signing key for a long-lived bridge. With signature
# enforcement disabled, the bridge can use its ephemeral key instead.
# CRIER_AGENT_PRIVATE_KEY_FILE=$HOME/.config/crier/mcp-agent.key

# Optional for a server started with CR_AUTH_TOKEN.
# CRIER_AUTH_TOKEN=replace-with-the-server-token
