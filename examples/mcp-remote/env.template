# Remote crier-mcp mode: these three variables unlock all 23 tools.
CRIER_HTTP_URL=http://localhost:8767
CRIER_AGENT_ID=mcp-agent
CRIER_MESH_URL=ws://localhost:8767/mesh/connect/mcp-agent

# Optional for a server started with CR_AUTH_TOKEN.
# CRIER_AUTH_TOKEN=replace-with-the-server-token
# Optional stable signing key for a long-lived bridge.
# CRIER_AGENT_PRIVATE_KEY_FILE=$HOME/.config/crier/mcp-agent.key
