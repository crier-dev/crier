#!/usr/bin/env bash
#
# scripts/hooks/pre-commit — the TRACKED source of truth for the crier commit
# gate (DF-CRIER-206).
#
# INSTALL:  make install-hooks        (idempotent; copies this file to
#                                     .git/hooks/pre-commit and verifies it)
#
# WHY THIS FILE EXISTS
# --------------------
# The installed hook was generated by gitreins and is untracked, so the hook
# the repo actually runs could not be reviewed, diffed or repaired from the
# repo. Worse, its Tier-1 battery (secrets / go_build / go_lint / go_tests)
# reads no shell script and no workflow YAML, so on a diff made only of those
# files it printed `Tier 1 Guards: PASS  (test mode: full)` having verified
# nothing about the diff (measured on this tree: an unterminated `if` in a .sh
# and an unclosed flow sequence in a workflow both PASSed). This wrapper keeps
# the guard exactly as it was and adds the missing half + an explicit statement
# of what the green does and does not cover.
#
# WHAT THE GATE COVERS, AND WHAT IT DOES NOT (DF-CRIER-206, DF-CRIER-209, DF-CRIER-189)
# ------------------------------------------------------------------------------------
# COVERS: `gitreins guard` Tier 1 — secrets, go_build, go_lint, go_tests — over
#         the staged Go work, plus (added here) `bash -n` on every staged shell
#         script and actionlint/PyYAML on every staged .github/workflows/*.yml,
#         plus (DF-CRIER-209) a `make -n` dry-parse of every staged Makefile and
#         a hadolint / built-in-python3 structural parse of every staged
#         Dockerfile, plus (DF-CRIER-189) `gofmt -l` on every staged .go file.
#         The gofmt arm is a real addition, not a re-run of Tier 1: go_lint is
#         `go vet`, which reports suspicious constructs and says NOTHING about
#         formatting. Measured at HEAD 973f5e1, two files drifted
#         (`gofmt -l $(git ls-files '*.go')` named internal/guard/types.go and
#         internal/webhook/schema.go) while the guard printed `Tier 1 Guards:
#         PASS`, so a drifting file could be committed on a green that verified
#         nothing about it.
# DOES NOT COVER: Markdown/prose drift (that is `make docs-check`, which executes
#         the claims in docs/claims.yaml); the shell INSIDE a Makefile recipe (the
#         dry-parse PRINTS recipes, it does not run them — a recipe that calls a
#         tracked script is covered by the shell arm on that script); Dockerfile
#         semantics beyond structure (no base-image existence check, no
#         hadolint-style lint rules when hadolint is absent, no `# escape=`
#         directive handling); formatting beyond gofmt's own rules (the gofmt arm
#         is not a linter, it does not replace `go vet`, and it reads only
#         TRACKED .go files — a generated or untracked .go file is outside it);
#         and any file outside the tracked set. A Tier-1 PASS over a diff with no
#         Go source still verified nothing about that diff, and the printed scope
#         line says so.
#
# INSTALLING / REPAIRING
# ----------------------
# .git/hooks/pre-commit is generated by gitreins and UNTRACKED, so this tracked
# file is the source of truth and `make install-hooks` puts it in place
# (idempotent; it backs up any existing hook first). MEASURED on gitreins
# (pipx install, cli.py cmd_install / cmd_init):
#   `gitreins install`       overwrites .git/hooks/pre-commit unconditionally
#   `gitreins init --reset`  overwrites it too (isfile(hook) or args.reset)
#   `gitreins init`          leaves an existing hook alone
# After either of the first two, re-run `make install-hooks`. Do NOT install this
# as a SYMLINK: `gitreins install` opens the hook path for writing, which writes
# THROUGH a symlink and overwrites the tracked file it points at (measured in a
# scratch repo). `make install-hooks` copies and verifies with `cmp` instead.
#
# WHAT IT DOES
# ------------
#  (1) `gitreins guard` — unchanged, same command, same exit semantics: a
#      nonzero guard stops the commit here, before anything else runs.
#  (2) scope disclosure. The staged set is read once (`git diff --cached
#      --name-only --diff-filter=ACMR`) and split into Go files, shell/workflow
#      files, Makefile/Dockerfile files, and everything else; the line printed
#      says which of those Tier 1 actually covers, and names the arms added here,
#      e.g.
#        gate scope: no Go source staged (no gofmt arm to run) — shell/YAML checks ran on 3 file(s): ...
#        gate scope: nothing guardable staged — the Tier-1 PASS verified nothing about this diff
#  (3) the gofmt checker (scripts/check-gofmt.sh, DF-CRIER-189) is run on EXACTLY
#      the staged .go files. It runs whenever a .go file is staged — a Go-only
#      diff is the shape whose green said "this gate had nothing to add" while
#      Tier-1 never read formatting at all. A failure exits nonzero, naming the
#      drifting file and showing its (bounded) `gofmt -d` diff.
#      A missing checker is itself a failure (exit 1): the gate must not degrade
#      into silence if someone deletes it.
#  (4) the shell/YAML checker (scripts/check-shell-yaml.sh) is run on EXACTLY the
#      staged shell/workflow files. It runs whenever such a file is staged — the
#      no-Go case is the one the vacuous PASS was measured on, and a Go diff that
#      also carries a shell script is covered too, because a green must never be
#      readable as "everything was verified". A failure exits nonzero.
#      A missing checker is itself a failure (exit 1), same rule as (3).
#  (5) the Makefile/Dockerfile checker (scripts/check-make-docker.sh,
#      DF-CRIER-209) is run on EXACTLY the staged Makefile/Dockerfile files, with
#      the same two rules: a missing checker is a hard failure (exit 1), and a
#      nonzero checker exit stops the commit. It runs whenever such a file is
#      staged, for the same reason as (4).
#
#  (6) the board checker (scripts/check-board.sh, DF-CRIER-387) is run whenever
#      a staged path is under .coding-hermes/board/. This is the arm whose
#      ABSENCE let an invalid board ship: a board-only diff has no Go, no shell
#      and no Makefile, so it used to fall through to `gate scope: nothing
#      guardable staged — exit 0` while `boardctl validate` was printing
#      `RESULT: FAIL (5 error(s))` on the same tree. Errors fail the commit;
#      warnings are printed and stay non-fatal, because the validator itself
#      tolerates legacy shapes and says so per line. A missing boardctl is exit
#      2, never a silent skip. Its own vocabulary gaps are boardctl's business,
#      not this hook's: the same row names that half.
#
# The classification below MIRRORS scripts/check-gofmt.sh (_is_go),
# scripts/check-shell-yaml.sh (_is_shell / _is_workflow) and
# scripts/check-make-docker.sh (_is_makefile / _is_dockerfile). Drift here can
# only narrow what this hook pre-checks, never hide a file from the gate: `make
# gofmt-check`, `make shell-yaml-check` and `make make-docker-check` (CI, and any
# local run) check every tracked file of their kind regardless of what is staged.
#
# NOTHING HERE WEAKENS THE GUARD: `gitreins guard` is still the first and
# blocking step, and --no-verify is still forbidden by AGENTS.md.

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || REPO_ROOT="$PWD"
cd "$REPO_ROOT" || exit 1

# ── (1) the guard, exactly as the generated hook ran it ───────────────────────
if [ ! -f "$REPO_ROOT/.gitreins/config.yaml" ]; then
  exit 0
fi

gitreins guard
guard_rc=$?
if [ "$guard_rc" -ne 0 ]; then
  exit "$guard_rc"
fi

# ── (2) derive the staged scope ───────────────────────────────────────────────
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
go_count=0
go_files=()
shell_yaml=()
make_docker=()
board_files=()

while IFS= read -r path; do
  [ -n "$path" ] || continue
  case "$path" in
    *.go)
      # MIRRORS scripts/check-gofmt.sh (_is_go): the .go suffix is the whole rule.
      go_files+=("$path")
      go_count=$((go_count + 1))
      continue
      ;;
  esac
  case "$path" in
    .coding-hermes/board/*)
      # MIRRORS scripts/check-board.sh: board data is the whole rule. This is
      # the shape that used to read "nothing guardable staged — exit 0", which
      # is exactly how an invalid board shipped (DF-CRIER-387).
      board_files+=("$path")
      continue
      ;;
  esac
  case "$path" in
    .github/workflows/*.yml | .github/workflows/*.yaml)
      shell_yaml+=("$path")
      continue
      ;;
  esac
  [ -f "$path" ] || continue # deleted in the index: no content to check
  # MIRRORS scripts/check-make-docker.sh (_is_makefile / _is_dockerfile): the
  # basename decides, and the Dockerfile spelling is matched case-insensitively.
  base="${path##*/}"
  case "$base" in
    Makefile | makefile | GNUmakefile | *.mk | Makefile.* | Dockerfile | Dockerfile.* | *.dockerfile)
      make_docker+=("$path")
      continue
      ;;
  esac
  base_lower="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')"
  case "$base_lower" in
    dockerfile | dockerfile.* | *.dockerfile)
      make_docker+=("$path")
      continue
      ;;
  esac
  case "$path" in
    *.sh)
      shell_yaml+=("$path")
      continue
      ;;
  esac
  first_line=""
  IFS= read -r first_line <"$path" 2>/dev/null || true
  case "$first_line" in
    '#!'*)
      if printf '%s\n' "$first_line" |
        grep -qE '^#!.*([/ ])(bash|sh|dash|ksh|zsh|ash|mksh)([[:space:]]|$)'; then
        shell_yaml+=("$path")
      fi
      ;;
  esac
done <<<"$staged"

n_go="${#go_files[@]}"
n_shell_yaml="${#shell_yaml[@]}"
n_make_docker="${#make_docker[@]}"
n_board="${#board_files[@]}"

# ── (2) state the scope, then check it ────────────────────────────────────────
# The scope line is printed BEFORE the checkers' per-file output so the gate log
# reads scope-then-evidence; each checker is always invoked right after it, and
# the hook cannot reach an exit below without having run the checkers it claims.
# The wordings keep every shape they described before — `gate scope: nothing
# guardable staged …` verbatim, and the DF-CRIER-206 / DF-CRIER-209 sentences
# unchanged — and now NAME the gofmt arm (DF-CRIER-189): a Go-only diff used to
# read "this gate had nothing to add", which stopped being true once an arm that
# reads formatting existed.
# ── the board arm: runs on EVERY commit, not only when a board file is staged ──
# DF-CRIER-389 (quorum #5): the first version of this arm fired only when a
# staged path was under .coding-hermes/board/, so it gated the DIFF and not the
# CONDITION. An invalid board is a state: it survives in the tree and can arrive
# through another lane's push or a direct write, and then every Go-only or empty
# commit read green while `boardctl validate` printed FAIL on the same tree.
# Like the gofmt arm (which reads the whole tracked .go set, never just staged
# files), this arm reads the WHOLE board on every commit. It is quiet about the
# validator's warnings and loud about its errors, and a repo with no board is
# told so rather than skipped silently.
BOARD_CHECKER="$REPO_ROOT/scripts/check-board.sh"
if [ -f "$BOARD_CHECKER" ]; then
  # DF-CRIER-399: a staged board row is what this commit will carry, so the
  # index is what gets validated - never the working tree that a staged-then-
  # restored edit would leave looking clean.
  if [ "$n_board" -gt 0 ]; then
    bash "$BOARD_CHECKER" -q --staged-index
  else
    bash "$BOARD_CHECKER" -q
  fi
  board_rc=$?
  if [ "$board_rc" -ne 0 ]; then
    echo "gate: board validation FAILED (exit $board_rc) — fix the rows named above; an invalid board is a durable queue every foreman lane reads" >&2
    exit "$board_rc"
  fi
  if [ "$n_board" -gt 0 ]; then
    echo "gate: board validation PASS (whole board; $n_board board file(s) also in this diff): ${board_files[*]}"
  else
    echo "gate: board validation PASS (whole board; no board file in this diff)"
  fi
else
  echo "gate: board arm UNAVAILABLE — $BOARD_CHECKER is missing, so this commit was NOT checked against the board canon" >&2
  if [ "$n_board" -gt 0 ]; then
    echo "gate: ERROR: a board change cannot be committed while the board checker is missing" >&2
    exit 1
  fi
fi

if [ "$n_make_docker" -eq 0 ]; then
  if [ "$go_count" -eq 0 ]; then
    if [ "$n_shell_yaml" -eq 0 ]; then
      echo "gate scope: nothing guardable staged — the Tier-1 PASS verified nothing about this diff (the board arm above still validated the whole board)"
      exit 0
    fi
    echo "gate scope: no Go source staged (so no gofmt arm to run) — shell/YAML checks ran on $n_shell_yaml file(s): ${shell_yaml[*]}"
  else
    if [ "$n_shell_yaml" -eq 0 ]; then
      echo "gate scope: $go_count Go file(s) staged — Tier-1 go_build/go_vet/go_tests cover them and the gofmt arm checked those $n_go Go file(s) for formatting drift; no shell/YAML file staged, so those are this gate's whole addition"
    else
      echo "gate scope: $go_count Go file(s) staged (Tier-1 go_build/go_vet/go_tests cover them; the gofmt arm checked those $n_go Go file(s) too) + $n_shell_yaml shell/YAML file(s) staged — those are checked here too: ${shell_yaml[*]}"
    fi
  fi
else
  if [ "$go_count" -eq 0 ]; then
    scope_prefix="no Go source staged (so no gofmt arm to run)"
  else
    scope_prefix="$go_count Go file(s) staged (Tier-1 go_build/go_vet/go_tests cover them; the gofmt arm checked those $n_go Go file(s) too)"
  fi
  if [ "$n_shell_yaml" -eq 0 ]; then
    scope_shell="no shell/YAML file staged"
  else
    scope_shell="shell/YAML checks ran on $n_shell_yaml file(s): ${shell_yaml[*]}"
  fi
  echo "gate scope: $scope_prefix — $scope_shell + $n_make_docker makefile/Dockerfile file(s) staged — those are checked here too: ${make_docker[*]}"
fi

# ── (3) gofmt on exactly the staged .go files (DF-CRIER-189) ──────────────────
if [ "$n_go" -gt 0 ]; then
  GO_CHECKER="$REPO_ROOT/scripts/check-gofmt.sh"
  if [ ! -f "$GO_CHECKER" ]; then
    echo "gate: ERROR: $GO_CHECKER is missing — refusing to let this commit through with the gofmt check unavailable" >&2
    exit 1
  fi

  bash "$GO_CHECKER" "${go_files[@]}"
  go_checker_rc=$?
  if [ "$go_checker_rc" -ne 0 ]; then
    echo "gate: gofmt check FAILED (exit $go_checker_rc) — fix the file(s) named above (gofmt -w <file>) and re-run; do not bypass this gate with --no-verify" >&2
    exit "$go_checker_rc"
  fi

  echo "gate: gofmt check PASS"
fi

if [ "$n_shell_yaml" -gt 0 ]; then
  CHECKER="$REPO_ROOT/scripts/check-shell-yaml.sh"
  if [ ! -f "$CHECKER" ]; then
    echo "gate: ERROR: $CHECKER is missing — refusing to let this commit through with the shell/YAML check unavailable" >&2
    exit 1
  fi

  bash "$CHECKER" "${shell_yaml[@]}"
  checker_rc=$?
  if [ "$checker_rc" -ne 0 ]; then
    echo "gate: shell/YAML check FAILED (exit $checker_rc) — fix the files named above; do not bypass this gate with --no-verify" >&2
    exit "$checker_rc"
  fi

  echo "gate: shell/YAML check PASS"
fi

if [ "$n_make_docker" -gt 0 ]; then
  MD_CHECKER="$REPO_ROOT/scripts/check-make-docker.sh"
  if [ ! -f "$MD_CHECKER" ]; then
    echo "gate: ERROR: $MD_CHECKER is missing — refusing to let this commit through with the Makefile/Dockerfile check unavailable" >&2
    exit 1
  fi

  bash "$MD_CHECKER" "${make_docker[@]}"
  md_checker_rc=$?
  if [ "$md_checker_rc" -ne 0 ]; then
    echo "gate: makefile/Dockerfile check FAILED (exit $md_checker_rc) — fix the files named above; do not bypass this gate with --no-verify" >&2
    exit "$md_checker_rc"
  fi

  echo "gate: makefile/Dockerfile check PASS"
fi

exit 0
