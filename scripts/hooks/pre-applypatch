#!/usr/bin/env bash
# Git am's post-application, pre-commit entrypoint. Validate the resulting index.
set -uo pipefail
root="$(git rev-parse --show-toplevel)" || exit 1
printf '%s\n' 'gate scope: pre-applypatch: this entrypoint validates the board only; content checks reach it through CI (Tier-1, gofmt, shell/YAML and Makefile/Dockerfile checks are NOT RUN here).'
checker="$root/scripts/check-board.sh"
if [ ! -f "$checker" ]; then
  echo "gate: pre-applypatch board arm UNAVAILABLE — $checker is missing" >&2
  exit 1
fi
exec bash "$checker" --staged-index
